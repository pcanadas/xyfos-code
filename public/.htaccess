# Force HTTPS and www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?xyfos\.com$ [NC]
RewriteRule ^ https://www.xyfos.com%{REQUEST_URI} [L,R=301]

# --------------------------------------------------
# Legacy store redirects (osCommerce → new site)
# All old store URLs → homepage with 301
# --------------------------------------------------

# Moved blog posts (the date is part of the URL)
RewriteRule ^blog/2026-06-11-quotedesk-crm-oferta/?$ /blog/2026-06-20-quotedesk-crm-oferta/ [L,R=301]

# Cuadra app API: real PHP endpoints, keep them out of the legacy redirects below
RewriteRule ^cuadra/api/ - [L]

# Error page: ErrorDocument serves it internally; without this the .html rule
# below turns every missing URL into a 301 to the home (soft 404)
RewriteRule ^404\.html$ - [L]

# PHP files (index.php, product_info.php, stock.php, specials.php, etc.)
RewriteRule ^(.+)\.php(/.*)?$ / [L,R=301]

# Old PDF articles
RewriteRule ^articulos/ / [L,R=301]

# Old forum
RewriteRule ^foro/ / [L,R=301]

# Old subsite
RewriteRule ^athenea/ / [L,R=301]

# Old Poland subsite
RewriteRule ^poland_first_to_fight/ / [L,R=301]

# Old PaymentStatus (likely spam/phishing attempt)
RewriteRule ^PaymentStatus/ / [L,R=301]

# Old .html product pages
RewriteRule ^(.+)\.html$ / [L,R=301]

# Custom error page
ErrorDocument 404 /404.html

# --------------------------------------------------
# Security headers
# HSTS sin includeSubDomains: los subdominios (apps, ftp...) se gestionan aparte.
# La CSP no limita scripts ni estilos (Astro inyecta algunos en línea); solo
# impide incrustar la web en otros sitios y cierra base/object/form.
# --------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
