---
import "@fontsource-variable/inter";
import "@fontsource-variable/inter-tight";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Path under /public or absolute URL; defaults to the site-wide share image. */
  image?: string;
  type?: "website" | "article";
  /** Full-bleed page: sections handle their own container (home). */
  bleed?: boolean;
}

const {
  bleed = false,
  title = site.name,
  description = "Diseño y desarrollo de software a medida: apps de escritorio y móviles, SaaS, automatizaciones y soluciones de datos.",
  canonical,
  image = "/og-image.png",
  type = "website",
} = Astro.props;
const url = canonical ?? Astro.url.href;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={url} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff7700" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    {image === "/og-image.png" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Xyfos Code: software a medida que resuelve problemas reales" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="alternate" type="application/rss+xml" title="Blog · Xyfos Code" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Changelog · Xyfos Code" href="/changelog/rss.xml" />
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="main" class={bleed ? "" : "container-site py-10 md:py-14"}>
      <slot />
    </main>
    <Footer />
  </body>
</html>