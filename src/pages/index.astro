---
// Home: "spec sheet" layout. Guide: docs/rediseno-home-2026-10.md
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import { services } from "../data/services";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import HeroShowcase from "../components/home/HeroShowcase.astro";
import ProductPanel from "../components/home/ProductPanel.astro";
import ServiceList from "../components/home/ServiceList.astro";
import ProcessTimeline from "../components/home/ProcessTimeline.astro";
import CaseFeature from "../components/home/CaseFeature.astro";
import TrustSection from "../components/home/TrustSection.astro";
import ContactBand from "../components/home/ContactBand.astro";
import { sortProjects, productRows, statusColors, statusLabels } from "../lib/content";

const projects = sortProjects(await getCollection("projects"));
const releases = await getCollection("changelog");
const rows = productRows(projects, releases);

const featured = projects.find((p) => p.slug === "cuadra");
const others = projects.filter((p) => p !== featured);

const steps = [
  {
    title: "Conversación",
    text: "Me cuentas el problema, cómo trabajáis hoy y qué resultado necesitas. Sin tecnicismos.",
    deliverable: "Un diagnóstico claro y si tiene sentido construir algo.",
  },
  {
    title: "Propuesta",
    text: "Defino qué se construye, en qué fases, con qué tecnología y en qué plazos.",
    deliverable: "Alcance por fases, plazos y presupuesto por escrito.",
  },
  {
    title: "Desarrollo iterativo",
    text: "Entregas pequeñas y frecuentes que puedes probar desde el principio y ajustar sobre la marcha.",
    deliverable: "Versiones que pruebas tú, cada una con su changelog.",
  },
  {
    title: "Entrega y soporte",
    text: "Puesta en producción y acompañamiento para que la herramienta siga funcionando.",
    deliverable: "Documentación, despliegue y mantenimiento.",
  },
];

// Only sectors stated in the bio or covered by own products — see docs/rediseno-home-2026-10.md
const sectors = ["eCommerce", "Análisis de mercado", "Marketing basado en datos", "Ventas técnicas B2B", "Finanzas personales"];
---

<SiteLayout
  title="Xyfos Code · Software a medida"
  description="Diseño y desarrollo de software a medida: apps de escritorio y móviles, SaaS, automatizaciones y soluciones de datos que resuelven problemas reales."
  bleed
>
  <!-- 1 · Hero -->
  <section class="border-b border-line" aria-labelledby="hero-title">
    <div class="container-site pb-12 pt-10 md:pb-16 md:pt-16">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-6">
          <p class="reveal flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted" style="--i: 0">
            <span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
            <span class="text-ink">{site.author}</span>
            <span aria-hidden="true">·</span>
            <span>Ingeniera de software</span>
            <span aria-hidden="true">·</span>
            <span>Disponible para proyectos</span>
          </p>

          <h1 id="hero-title" class="reveal mt-6 text-[2.5rem] font-semibold leading-[1.05] sm:text-5xl lg:text-[3.5rem]" style="--i: 1">
            Software a medida para tu empresa, de la idea a&nbsp;producción.
          </h1>

          <p class="reveal mt-6 max-w-prose text-body text-muted sm:text-lg" style="--i: 2">
            Apps de escritorio y móviles, plataformas web, automatizaciones y datos. Más de 20 años de experiencia,
            con entregas que puedes probar desde el principio y cada versión documentada.
          </p>

          <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--i: 3">
            <Button href="#contacto" size="lg" class="w-full sm:w-auto">Cuéntame tu proyecto</Button>
            <Button href="#casos" variant="secondary" size="lg" class="w-full sm:w-auto">Ver casos reales →</Button>
          </div>
          <p class="reveal mt-4 text-sm text-muted" style="--i: 3">Primera conversación sin compromiso.</p>
        </div>

        <figure class="reveal lg:col-span-6" style="--i: 4">
          <div class="rounded-lg bg-surface-warm p-4 sm:p-6">
            <HeroShowcase
              priority
              desktop={{ src: "/images/cuadra/dashboard_light.png", alt: "Cuadra en Windows: dashboard con resumen anual, previsión del mes y presupuestos", width: 1293, height: 879 }}
              phone={{ src: "/images/cuadra/android-screen-inicio.webp", alt: "Cuadra en Android: gastos, ingresos y previsión del mes", width: 400, height: 796 }}
            />
          </div>
          <figcaption class="mt-3 text-sm text-muted">
            <a class="font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text" href="/projects/cuadra/">Cuadra</a>:
            finanzas personales para Windows y Android. Producto propio.
          </figcaption>
        </figure>
      </div>

      <div class="reveal mt-12 md:mt-16" style="--i: 5">
        <ProductPanel rows={rows} />
      </div>
    </div>
  </section>

  <!-- 2 · §01 Services -->
  <Section
    id="servicios"
    number={1}
    eyebrow="Servicios"
    title="Qué puedo construir para ti"
    intro="Seis áreas técnicas en las que trabajo a diario. Cada proyecto combina las que haga falta."
  >
    <ServiceList services={services} />
    <p class="mt-8 text-[0.9375rem] text-muted">
      ¿No encaja en ninguna?
      <a class="font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text" href="#contacto">Cuéntamelo igualmente&nbsp;→</a>
    </p>
  </Section>

  <!-- 3 · §02 Process (warm block) -->
  <Section id="como-trabajo" number={2} tone="warm" eyebrow="Método" title="Del problema a la herramienta, sin sorpresas">
    <div class="pt-6 lg:pt-4">
      <ProcessTimeline steps={steps} />
    </div>
  </Section>

  <!-- 4 · §03 Cases & sectors -->
  <Section id="casos" number={3} eyebrow="Casos" title="Lo que ya he construido">
    <a slot="actions" class="text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-brand" href="/projects">
      Todos los proyectos →
    </a>

    {featured && (
      <CaseFeature
        project={featured}
        releases={releases}
        desktop={{ src: "/images/cuadra/movimientos.png", alt: "Cuadra en Windows: lista de movimientos con categorías y filtros", width: 1316, height: 689 }}
        phone={{ src: "/images/cuadra/android-screen-graficos.webp", alt: "Cuadra en Android: distribución de gastos por categoría", width: 400, height: 796 }}
        highlight={{ label: "Datos", value: "100 %", note: "en el dispositivo" }}
      />
    )}

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {others.map((p) => (
        <a
          href={`/projects/${p.slug}/`}
          class="group flex flex-col rounded-lg border border-line bg-surface p-6 transition-colors duration-150 hover:border-ink/30 sm:p-8"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              {p.data.platform && <p class="font-mono text-xs uppercase tracking-[0.1em] text-muted">{p.data.platform}</p>}
              <h3 class="mt-2 text-2xl font-semibold decoration-brand underline-offset-4 group-hover:underline">{p.data.title}</h3>
            </div>
            <span class={`shrink-0 rounded px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${statusColors[p.data.status]}`}>{statusLabels[p.data.status]}</span>
          </div>
          {p.data.problem && <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">{p.data.problem}</p>}
          <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink">{p.data.description}</p>
          <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
            <p class="font-mono text-xs text-muted">{p.data.stack.join(" · ")}</p>
            <span class="text-sm font-medium text-ink">Ver proyecto <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">→</span></span>
          </div>
        </a>
      ))}

      <a
        href="#contacto"
        class="group flex flex-col justify-between rounded-lg border border-dashed border-line-strong p-6 transition-colors duration-150 hover:border-ink/40 hover:bg-surface sm:p-8"
      >
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.1em] text-muted">Siguiente caso</p>
          <h3 class="mt-2 text-2xl font-semibold">¿Tu proyecto?</h3>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-muted">
            Una herramienta interna, una app para tus clientes o un proceso que hoy hacéis a mano.
          </p>
        </div>
        <span class="mt-6 text-sm font-medium text-ink underline decoration-brand underline-offset-4 group-hover:text-brand-text">Cuéntamelo →</span>
      </a>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-baseline sm:gap-6">
      <h3 class="shrink-0 font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">Sectores con experiencia</h3>
      <ul class="flex flex-wrap gap-2">
        {sectors.map((s) => (
          <li class="rounded border border-line bg-surface px-2.5 py-1 text-sm text-ink">{s}</li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- 5 · §04 Trust (warm block + personal presence) -->
  <TrustSection projects={projects} releases={releases} />

  <!-- 6 · §05 Contact (dark band, continues into the footer) -->
  <ContactBand />
</SiteLayout>
