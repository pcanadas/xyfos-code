---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";
import ProjectCard from "../components/ui/ProjectCard.astro";
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import { sortProjects, sortChangelog, latestReleaseByProject, formatDate, isoDate } from "../lib/content";

const focus = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2";

const projects = sortProjects(await getCollection("projects"));

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allReleases = await getCollection("changelog");
const latestRelease = latestReleaseByProject(allReleases);
const changelog = sortChangelog(allReleases).slice(0, 4);
// Most recent release of any product (excludes the website's own entries)
const heroRelease = sortChangelog(allReleases).find((e) => e.data.project && e.data.project !== "Xyfos Code");

// Icon paths: 24x24 stroke icons.
// Grid: 2 wide cards (with examples) on top, 3 narrower below on desktop.
const services = [
  {
    title: "Apps de escritorio",
    text: "Aplicaciones para Windows rápidas, fiables y con los datos en tu equipo.",
    example: { label: "Cuadra", href: "/projects/cuadra/" },
    icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
    span: "lg:col-span-3",
  },
  {
    title: "SaaS y aplicaciones web",
    text: "Plataformas multiusuario, paneles de gestión y CRMs adaptados a cómo trabaja tu equipo.",
    example: { label: "QuoteDesk", href: "/projects/quotedesk/" },
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
    span: "lg:col-span-3",
  },
  {
    title: "Automatización e integraciones",
    text: "Python, Selenium y Google APIs (Calendar, Meet, Drive) para conectar herramientas y eliminar tareas repetitivas.",
    icon: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
    span: "lg:col-span-2",
  },
  {
    title: "Datos y analítica",
    text: "Procesos ETL, web scraping y conectores para Power BI con Pandas y MySQL, para decidir con datos fiables.",
    icon: '<path d="M3 3v18h18"/><path d="M7 16v-4M12 16V8M17 16v-7"/>',
    span: "lg:col-span-2",
  },
  {
    title: "Infraestructura cloud",
    text: "Despliegue y operación en AWS: EC2, Auto Scaling, EFS y SSM, con bases de datos MySQL.",
    icon: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/>',
    span: "sm:col-span-2 lg:col-span-2",
  },
];

const steps = [
  {
    title: "Conversación",
    text: "Me cuentas el problema, cómo trabajáis hoy y qué resultado necesitas. Sin tecnicismos.",
  },
  {
    title: "Propuesta",
    text: "Te envío un alcance claro: qué se construye, en qué fases, con qué tecnología y en qué plazos.",
  },
  {
    title: "Desarrollo iterativo",
    text: "Entregas pequeñas y frecuentes que puedes probar desde el principio y ajustar sobre la marcha.",
  },
  {
    title: "Entrega y soporte",
    text: "Puesta en producción, documentación y acompañamiento para que la herramienta siga funcionando.",
  },
];
---

<SiteLayout
  title="Xyfos Code · Software a medida"
  description="Diseño y desarrollo de software a medida: apps de escritorio, SaaS, automatizaciones y soluciones de datos que resuelven problemas reales."
  bleed
>
  <!-- Hero (direction A) -->
  <section class="border-b border-line" aria-labelledby="hero-title">
    <div class="container-site grid gap-12 pb-12 pt-12 md:pt-20 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pb-16">
      <div class="lg:col-span-6">
        <p class="flex items-center gap-2 font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">
          <span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
          Disponible para nuevos proyectos
        </p>

        <h1 id="hero-title" class="mt-6 text-[2.5rem] font-semibold leading-[1.05] sm:text-5xl lg:text-[3.5rem]">
          Software a medida, construido con criterio de ingeniería.
        </h1>

        <p class="mt-6 max-w-prose text-body text-muted sm:text-lg">
          Diseño y desarrollo aplicaciones, automatizaciones y sistemas de datos para empresas que
          necesitan herramientas fiables, documentadas y fáciles de mantener.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href="#contacto" size="lg">Hablemos de tu proyecto</Button>
          <Button href="/projects" variant="secondary" size="lg">Ver casos</Button>
        </div>
      </div>

      <figure class="lg:col-span-6">
        <div class="rounded-lg bg-surface-warm p-3 sm:p-5">
          <div class="overflow-hidden rounded-md border border-line bg-surface">
            <div class="flex items-center gap-1.5 border-b border-line px-3 py-2" aria-hidden="true">
              <span class="h-2 w-2 rounded-full bg-line-strong"></span>
              <span class="h-2 w-2 rounded-full bg-line-strong"></span>
              <span class="h-2 w-2 rounded-full bg-line-strong"></span>
            </div>
            <img
              src="/images/cuadra/dashboard_light.png"
              alt="Dashboard de Cuadra con resumen anual de gastos, ingresos, previsión del mes y presupuestos por categoría"
              width="1293"
              height="879"
              class="block w-full"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
        <figcaption class="mt-3 text-sm text-muted">
          <a class="font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text" href="/projects/cuadra/">Cuadra</a>:
          app de escritorio para finanzas del hogar. Proyecto propio, en beta.
        </figcaption>
      </figure>
    </div>

    <!-- Proof strip -->
    <div class="container-site">
      <dl class="grid border-t border-line sm:grid-cols-3 sm:divide-x sm:divide-line">
        <div class="py-5 sm:pr-6">
          <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Experiencia</dt>
          <dd class="mt-1 font-display text-2xl font-semibold tabular-nums">20+ años</dd>
        </div>
        <div class="border-t border-line py-5 sm:border-t-0 sm:px-6">
          <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Áreas técnicas</dt>
          <dd class="mt-1 text-sm text-muted">
            <span class="block font-display text-2xl font-semibold text-ink tabular-nums">{services.length}</span>
            Escritorio, SaaS, automatización, datos y cloud
          </dd>
        </div>
        {heroRelease && (
          <div class="border-t border-line py-5 sm:border-t-0 sm:pl-6">
            <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Última versión publicada</dt>
            <dd class="mt-1 text-sm text-muted">
              <a class="block font-mono text-2xl font-medium text-ink hover:text-brand-text" href={`/changelog/${heroRelease.slug}/`}>
                {heroRelease.data.version}
              </a>
              {heroRelease.data.project} · <time datetime={isoDate(heroRelease.data.date)}>{formatDate(heroRelease.data.date)}</time> ·
              <a class="font-medium text-brand-text underline underline-offset-4" href="/changelog">changelog</a>
            </dd>
          </div>
        )}
      </dl>
    </div>
  </section>

  <!-- Sections below still use the previous styling; they move to the design system one by one. -->
  <!-- Services -->
  <Section
    id="servicios"
    eyebrow="Servicios"
    title="Qué puedo construir para ti"
    intro="Cinco áreas técnicas en las que trabajo a diario. Cada proyecto combina las que haga falta."
  >
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {services.map((s, i) => (
        <li class={`flex flex-col rounded-lg border border-line bg-surface p-6 ${s.span}`}>
          <div class="flex items-start justify-between">
            <svg class="text-ink" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
            <span class="font-mono text-xs text-muted tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h3 class="mt-6 text-lg font-semibold">{s.title}</h3>
          <p class="mt-2 flex-1 text-[0.9375rem] leading-relaxed text-muted">{s.text}</p>
          {s.example && (
            <p class="mt-5 border-t border-line pt-4 text-sm text-muted">
              Ejemplo:
              <a class="font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text" href={s.example.href}>{s.example.label}</a>
            </p>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- Projects -->
  <Section id="proyectos" eyebrow="Casos" title="Lo que ya he construido" class="border-t border-line">
    <a slot="actions" class="text-sm font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-brand" href="/projects">
      Ver todos los proyectos →
    </a>

    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((p) => (
        <ProjectCard project={p} release={latestRelease.get(p.data.title)} />
      ))}
    </div>
  </Section>

  <!-- Sections below still use the previous styling; they move to the design system one by one. -->
  <div class="container-site pb-16">

  <!-- Process -->
  <section class="mt-20 rounded-2xl bg-slate-50 p-6 sm:p-10" aria-labelledby="como-trabajo">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-text">Cómo trabajo</p>
    <h2 id="como-trabajo" class="mt-2 max-w-2xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
      Del problema a la herramienta, paso a paso
    </h2>

    <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="rounded-xl border border-slate-200 bg-white p-6">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-900 text-sm font-semibold tabular-nums text-white" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="mt-4 font-semibold text-slate-900">{step.title}</h3>
          <p class="mt-2 text-sm text-slate-600">{step.text}</p>
        </li>
      ))}
    </ol>

    <p class="mt-8 max-w-2xl text-sm text-slate-600">
      <span class="font-medium text-slate-900">Desarrollo en abierto.</span>
      Así trabajo también en mis propios proyectos: cada versión y cada decisión quedan documentadas en el
      <a class={`rounded-sm font-medium text-slate-900 underline decoration-brand-500/60 underline-offset-4 hover:decoration-brand-500 ${focus}`} href="/changelog">changelog</a>
      y el
      <a class={`rounded-sm font-medium text-slate-900 underline decoration-brand-500/60 underline-offset-4 hover:decoration-brand-500 ${focus}`} href="/roadmap">roadmap</a>.
    </p>
  </section>

  <!-- About -->
  <section class="mt-20 grid gap-10 md:grid-cols-[1fr_18rem]" aria-labelledby="sobre-mi">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-text">Sobre mí</p>
      <h2 id="sobre-mi" class="mt-2 max-w-2xl text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        Más de 20 años resolviendo problemas con tecnología
      </h2>
      <div class="mt-6 max-w-2xl space-y-4 text-slate-700">
        <p>
          Soy {site.author}, desarrolladora especializada en backend, integración y análisis de datos.
          He trabajado en proyectos de eCommerce, análisis de mercado y marketing digital basado en datos.
        </p>
        <p>
          Trabajo sobre todo con Python, PHP y JavaScript: automatizaciones, integraciones de APIs,
          web scraping, procesos ETL y conectores de datos para herramientas como Power BI.
        </p>
        <p>
          Me gusta resolver problemas complejos con soluciones robustas, eficientes y bien documentadas.
        </p>
      </div>
    </div>

    <aside class="self-start rounded-2xl border border-slate-200 bg-white p-6">
      <div class="flex items-center gap-4">
        {site.photo ? (
          <img src={site.photo} alt={site.author} width="64" height="64" class="h-16 w-16 rounded-full object-cover" loading="lazy" />
        ) : (
          <span class="inline-flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brand-500 text-xl font-semibold text-slate-950" aria-hidden="true">
            PC
          </span>
        )}
        <div>
          <p class="font-semibold text-slate-900">{site.author}</p>
          <p class="text-sm text-slate-600">Backend y datos</p>
        </div>
      </div>

      <dl class="mt-6 border-t border-slate-100 pt-5">
        <dt class="text-sm text-slate-600">Experiencia</dt>
        <dd class="mt-0.5 text-2xl font-semibold tabular-nums text-slate-900">20+ años</dd>
      </dl>

      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías principales">
        {["Python", "PHP", "JavaScript", "MySQL", "Pandas", "Selenium", "Power BI", "AWS"].map((tech) => (
          <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{tech}</li>
        ))}
      </ul>

      <div class="mt-6 flex gap-5 text-sm">
        <a class={`rounded-sm font-medium text-slate-900 hover:text-brand-text ${focus}`} href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a class={`rounded-sm font-medium text-slate-900 hover:text-brand-text ${focus}`} href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </aside>
  </section>

  <!-- Latest updates -->
  <section class="mt-20 grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 p-6">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-xl font-semibold">Blog</h2>
        <a class="text-sm text-slate-600 hover:text-slate-900" href="/blog">Todos →</a>
      </div>

      <ul class="mt-5 space-y-4">
        {posts.map((p) => (
          <li>
            <a class="font-medium underline decoration-brand-500/50 underline-offset-4" href={`/blog/${p.slug}/`}>
              {p.data.title}
            </a>
            <div class="mt-1 text-sm text-slate-600">
              {formatDate(p.data.date)}
              {p.data.description ? ` · ${p.data.description}` : ""}
            </div>
          </li>
        ))}
        {posts.length === 0 && <li class="text-sm text-slate-600">Sin publicaciones aún.</li>}
      </ul>
    </div>

    <div class="rounded-2xl border border-slate-200 p-6">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-xl font-semibold">Últimos cambios</h2>
        <a class="text-sm text-slate-600 hover:text-slate-900" href="/changelog">Changelog →</a>
      </div>

      <ul class="mt-5 space-y-4">
        {changelog.map((e) => (
          <li>
            <a class="font-medium underline decoration-brand-500/50 underline-offset-4" href={`/changelog/${e.slug}/`}>
              {e.data.version} — {e.data.title}
            </a>
            <div class="mt-1 flex items-center gap-2 text-sm text-slate-600">
              {formatDate(e.data.date)}
              {e.data.project && (
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs">{e.data.project}</span>
              )}
            </div>
          </li>
        ))}
        {changelog.length === 0 && <li class="text-sm text-slate-600">Sin releases aún.</li>}
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section id="contacto" class="mt-16 scroll-mt-6 rounded-2xl bg-slate-900 p-8 text-white sm:p-12">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="max-w-xl">
        <h2 class="text-2xl font-semibold sm:text-3xl">¿Tienes un problema que el software podría resolver?</h2>
        <p class="mt-3 text-white/80">
          Cuéntamelo por email y te digo cómo lo abordaría. Sin compromiso.
        </p>
      </div>

      <div class="flex flex-col gap-4 md:items-end">
        <a
          class={`rounded-md bg-brand-500 px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-brand-400 focus-visible:ring-offset-slate-900 ${focus}`}
          href={`mailto:${site.email}?subject=${encodeURIComponent("Proyecto desde xyfos.com")}`}
        >
          Escríbeme a {site.email}
        </a>
        <div class="flex gap-5 text-sm">
          <a class={`rounded-sm text-white/80 hover:text-white focus-visible:ring-offset-slate-900 ${focus}`} href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class={`rounded-sm text-white/80 hover:text-white focus-visible:ring-offset-slate-900 ${focus}`} href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>
  </div>
</SiteLayout>
