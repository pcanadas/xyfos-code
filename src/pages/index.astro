---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const changelog = (await getCollection("changelog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const statusColors: Record<string, string> = {
  alpha: "bg-amber-100 text-amber-800 ring-amber-200",
  beta:  "bg-sky-100 text-sky-800 ring-sky-200",
  live:  "bg-emerald-100 text-emerald-800 ring-emerald-200",
};
---

<SiteLayout
  title="Xyfos Code"
  description="Software propio: herramientas prácticas que resuelven problemas reales."
>
  <!-- Hero -->
  <section class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white">
    <div class="absolute inset-0">
      <div class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand-200/50 blur-3xl"></div>
      <div class="absolute -right-24 -bottom-24 h-72 w-72 rounded-full bg-brand-300/40 blur-3xl"></div>
    </div>

    <div class="relative p-8 sm:p-12">
      <div class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1 text-xs text-slate-700">
        <span class="h-2 w-2 rounded-full bg-brand-500"></span>
        Xyfos Code
      </div>

      <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">
        Software que
        <span class="underline decoration-brand-500/70 decoration-4 underline-offset-4">
          resuelve problemas reales
        </span>.
      </h1>

      <p class="mt-5 max-w-2xl text-lg text-slate-700">
        Desarrollo herramientas propias — desde apps de escritorio hasta SaaS — con foco en
        simplicidad, utilidad y buen diseño. Cada proyecto nace de una necesidad concreta.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          class="rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-800"
          href="/projects"
        >
          Ver proyectos
        </a>
        <a
          class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium hover:bg-slate-50"
          href="/roadmap"
        >
          Roadmap
        </a>
        <a
          class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium hover:bg-slate-50"
          href="/blog"
        >
          Blog
        </a>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="mt-12">
    <div class="flex items-baseline justify-between gap-3">
      <h2 class="text-xl font-semibold">Proyectos</h2>
      <a class="text-sm text-slate-600 hover:text-slate-900" href="/projects">Ver todos →</a>
    </div>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {projects.map((p) => (
        <a
          href={`/projects/${p.slug}/`}
          class="group flex flex-col rounded-2xl border border-slate-200 p-6 hover:border-slate-300 hover:bg-slate-50 transition-colors"
        >
          <div class="flex items-start justify-between gap-3">
            <div class="text-lg font-semibold text-slate-900 group-hover:underline decoration-brand-500/50 underline-offset-4">
              {p.data.title}
            </div>
            <span class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${statusColors[p.data.status] || "bg-slate-100 text-slate-700 ring-slate-200"}`}>
              {p.data.status}
            </span>
          </div>
          <p class="mt-2 text-sm text-slate-600 flex-1">{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest updates -->
  <section class="mt-12 grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 p-6">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-xl font-semibold">Blog</h2>
        <a class="text-sm text-slate-600 hover:text-slate-900" href="/blog">Todos →</a>
      </div>

      <ul class="mt-5 space-y-4">
        {posts.map((p) => (
          <li>
            <a class="font-medium underline decoration-brand-500/50 underline-offset-4" href={`/blog/${p.slug}/`}>
              {p.data.title}
            </a>
            <div class="mt-1 text-sm text-slate-600">
              {p.data.date.toISOString().slice(0, 10)}
              {p.data.description ? ` · ${p.data.description}` : ""}
            </div>
          </li>
        ))}
        {posts.length === 0 && <li class="text-sm text-slate-600">Sin publicaciones aún.</li>}
      </ul>
    </div>

    <div class="rounded-2xl border border-slate-200 p-6">
      <div class="flex items-baseline justify-between gap-3">
        <h2 class="text-xl font-semibold">Últimos cambios</h2>
        <a class="text-sm text-slate-600 hover:text-slate-900" href="/changelog">Changelog →</a>
      </div>

      <ul class="mt-5 space-y-4">
        {changelog.map((e) => (
          <li>
            <a class="font-medium underline decoration-brand-500/50 underline-offset-4" href={`/changelog/${e.slug}/`}>
              {e.data.version} — {e.data.title}
            </a>
            <div class="mt-1 flex items-center gap-2 text-sm text-slate-600">
              {e.data.date.toISOString().slice(0, 10)}
              {e.data.project && (
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs">{e.data.project}</span>
              )}
            </div>
          </li>
        ))}
        {changelog.length === 0 && <li class="text-sm text-slate-600">Sin releases aún.</li>}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="mt-12 rounded-2xl border border-slate-200 bg-slate-900 p-8 text-white">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="text-2xl font-semibold">Desarrollo en abierto</h2>
        <p class="mt-2 text-white/80">
          Progreso transparente: cada release, cada decisión, documentada en el changelog y el roadmap.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          class="rounded-md bg-white px-5 py-2.5 text-sm font-medium text-slate-900 hover:bg-brand-50"
          href="/projects"
        >
          Proyectos
        </a>
        <a
          class="rounded-md border border-white/20 px-5 py-2.5 text-sm font-medium hover:bg-white/10"
          href="/roadmap"
        >
          Roadmap
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
