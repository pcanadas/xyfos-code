---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import { getCollection } from "astro:content";
import { formatDate, isoDate, roadmapStatusLabels, roadmapStatusColors } from "../../lib/content";

export async function getStaticPaths() {
  const items = await getCollection("roadmap");
  return items.map((r) => ({ params: { slug: r.slug }, props: { item: r } }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const { title, date, status, project } = item.data;
---
<SiteLayout
  title={`${title} · Roadmap · Xyfos Code`}
  description={`Roadmap${project ? ` de ${project}` : ""}: ${title}`}
>
  <div class="mx-auto max-w-3xl">
    <PageHeader back={{ href: "/roadmap", label: "Roadmap" }} eyebrow={project} title={title}>
      <p class="flex flex-wrap items-center gap-3 font-mono text-sm text-muted">
        <span class={`rounded px-2 py-0.5 font-sans text-xs font-medium ring-1 ring-inset ${roadmapStatusColors[status]}`}>
          {roadmapStatusLabels[status]}
        </span>
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
      </p>
    </PageHeader>

    <article class="prose prose-site max-w-none">
      <Content />
    </article>
  </div>
</SiteLayout>
