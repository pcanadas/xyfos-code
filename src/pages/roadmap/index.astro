---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import { getCollection } from "astro:content";
import { formatDate, isoDate } from "../../lib/content";

const items = (await getCollection("roadmap")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const sections = [
  { status: "in-progress", title: "En progreso", dot: "bg-amber-500" },
  { status: "planned",     title: "Planificado", dot: "bg-slate-400" },
  { status: "done",        title: "Completado",  dot: "bg-emerald-600" },
].map((s) => ({ ...s, items: items.filter((i) => i.data.status === s.status) }));
---
<SiteLayout title="Roadmap · Xyfos Code" description="Dirección y próximos hitos de todos los proyectos de Xyfos Code.">
  <PageHeader
    eyebrow="Desarrollo en abierto"
    title="Roadmap"
    intro="Hacia dónde van los proyectos: lo que estoy construyendo, lo que viene después y lo que ya está hecho."
  />

  <div class="grid gap-6 md:grid-cols-3">
    {sections.map((s) => (
      <section class="rounded-lg border border-line bg-surface" aria-labelledby={`col-${s.status}`}>
        <div class="flex items-center justify-between border-b border-line px-5 py-4">
          <h2 id={`col-${s.status}`} class="flex items-center gap-2 text-base font-semibold">
            <span class={`h-2 w-2 rounded-full ${s.dot}`} aria-hidden="true"></span>
            {s.title}
          </h2>
          <span class="font-mono text-xs text-muted tabular-nums">{s.items.length}</span>
        </div>
        <ul class="space-y-3 p-4">
          {s.items.map((i) => (
            <li>
              <a class="group block rounded-md border border-line p-4 hover:border-ink/30" href={`/roadmap/${i.slug}/`}>
                <span class="block font-medium group-hover:underline group-hover:decoration-brand group-hover:underline-offset-4">{i.data.title}</span>
                <span class="mt-2 flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
                  <time datetime={isoDate(i.data.date)}>{formatDate(i.data.date)}</time>
                  {i.data.project && <span class="rounded border border-line px-1.5 py-0.5">{i.data.project}</span>}
                </span>
              </a>
            </li>
          ))}
          {s.items.length === 0 && <li class="px-1 py-2 text-sm text-muted">Sin elementos aún.</li>}
        </ul>
      </section>
    ))}
  </div>
</SiteLayout>
