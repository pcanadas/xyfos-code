---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import { getCollection } from "astro:content";
import { sortProjects, latestReleasesByProject } from "../../lib/content";

const projects = sortProjects(await getCollection("projects"));
const latestReleases = latestReleasesByProject(await getCollection("changelog"));
---
<SiteLayout title="Proyectos · Xyfos Code" description="Proyectos desarrollados en Xyfos Code: apps de escritorio, móviles y SaaS a medida.">
  <PageHeader
    eyebrow="Casos"
    title="Proyectos"
    intro="Herramientas y productos desarrollados en Xyfos Code. Cada uno nace de un problema concreto."
  />

  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((p) => (
      <ProjectCard project={p} releases={latestReleases.get(p.data.title)} />
    ))}
  </div>
</SiteLayout>
