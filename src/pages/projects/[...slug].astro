---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { statusColors, statusLabels } from "../../lib/content";

export async function getStaticPaths() {
  const items = await getCollection("projects");
  return items.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const isGithub = project.data.url.includes("github.com");
---
<SiteLayout title={`${project.data.title} · Proyectos · Xyfos Code`} description={project.data.description}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-semibold">{project.data.title}</h1>
      <p class="mt-2 text-slate-700">{project.data.description}</p>
    </div>

    <div class="flex items-center gap-2">
      <span class={`rounded-full px-3 py-1 text-sm font-medium ring-1 ring-inset ${statusColors[project.data.status]}`}>
        {statusLabels[project.data.status]}
      </span>
      <a
        class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2"
        href={project.data.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        {isGithub ? "Ver en GitHub ↗" : "Abrir aplicación ↗"}
      </a>
    </div>
  </div>

  <article class="prose prose-slate mt-8 max-w-none">
    <Content />
  </article>
</SiteLayout>
