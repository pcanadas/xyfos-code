---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("projects");
  return items.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const statusColors: Record<string, string> = {
  alpha: "bg-amber-100 text-amber-800 ring-amber-200",
  beta:  "bg-sky-100 text-sky-800 ring-sky-200",
  live:  "bg-emerald-100 text-emerald-800 ring-emerald-200",
  public: "bg-slate-100 text-slate-700 ring-slate-200",
  private: "bg-slate-100 text-slate-500 ring-slate-200",
};
---
<SiteLayout title={`${project.data.title} · Proyectos · Xyfos Code`} description={project.data.description}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-3xl font-semibold">{project.data.title}</h1>
      <p class="mt-2 text-slate-700">{project.data.description}</p>
    </div>

    <div class="flex items-center gap-2">
      <span class={`rounded-full px-3 py-1 text-sm font-medium ring-1 ring-inset ${statusColors[project.data.status] || "bg-slate-100 text-slate-700 ring-slate-200"}`}>
        {project.data.status}
      </span>
      <a
        class="rounded-md bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-800"
        href={project.data.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        Abrir →
      </a>
    </div>
  </div>

  <article class="prose prose-slate mt-8 max-w-none">
    <Content />
  </article>
</SiteLayout>
