---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import Button from "../../components/ui/Button.astro";
import { getCollection } from "astro:content";
import { site } from "../../config/site";
import { statusColors, statusLabels, editionColors, sortChangelog, releaseTitle, formatDate, isoDate } from "../../lib/content";

export async function getStaticPaths() {
  const items = await getCollection("projects");
  return items.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, description, status, problem, platform, stack, url, editions } = project.data;
const isGithub = url.includes("github.com");

const allReleases = sortChangelog(await getCollection("changelog")).filter((e) => e.data.project === title);

// One release list per edition (or a single unnamed group), newest first
const releaseGroups = editions.length
  ? editions.map((ed) => ({ name: ed.name, items: allReleases.filter((e) => e.data.platform === ed.name).slice(0, 3) }))
  : [{ name: undefined, items: allReleases.slice(0, 5) }];
const latestByEdition = new Map(releaseGroups.map((g) => [g.name, g.items[0]]));
---
<SiteLayout title={`${title} · Proyectos · Xyfos Code`} description={description}>
  <PageHeader back={{ href: "/projects", label: "Proyectos" }} eyebrow={platform} title={title} intro={description}>
    <div class="flex flex-wrap items-center gap-3">
      <Button href={url} external>{isGithub ? "Ver en GitHub ↗" : "Abrir aplicación ↗"}</Button>
      <span class={`rounded px-2.5 py-1 text-sm font-medium ring-1 ring-inset ${statusColors[status]}`}>
        {statusLabels[status]}
      </span>
    </div>
  </PageHeader>

  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="min-w-0 lg:col-span-8">
      {problem && (
        <div class="mb-10 rounded-lg bg-surface-warm p-6">
          <p class="eyebrow">El problema</p>
          <p class="mt-2 text-body">{problem}</p>
        </div>
      )}

      {editions.length > 0 && (
        <section class="mb-12" aria-labelledby="versiones-title">
          <h2 id="versiones-title" class="eyebrow">{editions.length} versiones</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {editions.map((ed) => {
              const latest = latestByEdition.get(ed.name);
              return (
                <li class="flex flex-col rounded-lg border border-line bg-surface p-6">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <h3 class="text-xl font-semibold">{ed.name}</h3>
                      <p class="mt-1 font-mono text-xs uppercase tracking-[0.1em] text-muted">{ed.platform}</p>
                    </div>
                    <span class={`shrink-0 rounded px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${editionColors[ed.tone]}`}>{ed.availability}</span>
                  </div>
                  <p class="mt-4 flex-1 text-[0.9375rem] leading-relaxed text-muted">{ed.summary}</p>
                  {latest && (
                    <p class="mt-4 text-sm text-muted">
                      Última versión
                      <a class="font-mono font-medium text-ink underline decoration-line-strong underline-offset-4 hover:decoration-brand" href={`/changelog/${latest.slug}/`}>{latest.data.version}</a>
                      · <time class="whitespace-nowrap" datetime={isoDate(latest.data.date)}>{formatDate(latest.data.date)}</time>
                    </p>
                  )}
                  {ed.link && (
                    <a
                      class="mt-4 border-t border-line pt-4 text-sm font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text"
                      href={ed.link.href}
                      {...(ed.link.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    >
                      {ed.link.label} {ed.link.href.startsWith("http") ? "↗" : "↓"}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}

      <article class="prose prose-site max-w-none">
        <Content />
      </article>
    </div>

    <aside class="space-y-6 lg:col-span-4">
      <div class="rounded-lg border border-line bg-surface p-6 lg:sticky lg:top-6">
        <dl class="space-y-4 text-sm">
          {platform && (
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Plataforma</dt>
              <dd class="mt-1 font-medium">{platform}</dd>
            </div>
          )}
          {stack.length > 0 && (
            <div>
              <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Tecnologías</dt>
              <dd class="mt-2">
                <ul class="flex flex-wrap gap-1.5">
                  {stack.map((tech) => <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">{tech}</li>)}
                </ul>
              </dd>
            </div>
          )}
        </dl>

        {allReleases.length > 0 && (
          <div class="mt-6 border-t border-line pt-5">
            <h2 class="font-mono text-xs font-medium uppercase tracking-[0.14em] text-muted">Últimas versiones</h2>
            {releaseGroups.filter((g) => g.items.length).map((g) => (
              <div class="mt-4">
                {g.name && <h3 class="text-sm font-semibold">{g.name}</h3>}
                <ul class="mt-2 space-y-3">
                  {g.items.map((e) => (
                    <li>
                      <a class="group block" href={`/changelog/${e.slug}/`}>
                        <span class="font-mono text-sm font-medium">{e.data.version}</span>
                        <span class="ml-2 font-mono text-xs text-muted"><time datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time></span>
                        <span class="mt-0.5 block text-sm text-muted group-hover:text-ink group-hover:underline group-hover:decoration-brand group-hover:underline-offset-4">{releaseTitle(e)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <a class="mt-5 inline-block text-sm font-medium underline decoration-line-strong underline-offset-4 hover:decoration-brand" href="/changelog">Changelog completo →</a>
          </div>
        )}
      </div>
    </aside>
  </div>

  <section class="mt-16 rounded-lg bg-ink p-8 text-white sm:p-10" aria-labelledby="cta-title">
    <h2 id="cta-title" class="text-2xl font-semibold text-white sm:text-3xl">¿Necesitas una herramienta parecida?</h2>
    <p class="mt-3 max-w-prose text-white/75">Cuéntame qué problema quieres resolver y te digo cómo lo abordaría.</p>
    <div class="mt-6">
      <Button href={`mailto:${site.email}?subject=${encodeURIComponent(`Proyecto similar a ${title}`)}`} size="lg">Escríbeme</Button>
    </div>
  </section>
</SiteLayout>
