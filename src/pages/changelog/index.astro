---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import { getCollection } from "astro:content";
import { sortChangelog, releaseTitle, formatDate, isoDate } from "../../lib/content";

const entries = sortChangelog(await getCollection("changelog"));

const projects = [...new Set(entries.map((e) => e.data.project).filter((p): p is string => !!p))]
  .sort((a, b) => a.localeCompare(b, "es"))
  .map((name) => ({ name, count: entries.filter((e) => e.data.project === name).length }));

const chip = "inline-flex min-h-9 items-center gap-2 rounded-full border border-line bg-surface px-3.5 font-mono text-xs text-muted hover:border-ink/30 hover:text-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-bg";
---
<SiteLayout title="Changelog · Xyfos Code" description="Nuevas versiones y cambios de todos los proyectos de Xyfos Code.">
  <PageHeader
    eyebrow="Desarrollo en abierto"
    title="Changelog"
    intro="Nuevas versiones, correcciones y mejoras de todos los proyectos, en orden cronológico."
  >
    <a class="font-mono text-xs uppercase tracking-[0.14em] text-muted hover:text-ink" href="/changelog/rss.xml">Suscribirse por RSS</a>
  </PageHeader>

  {projects.length > 1 && (
    <div class="mb-6 flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar por proyecto" data-changelog-filter>
      <button type="button" class={chip} data-project="" aria-pressed="true">
        Todos <span class="tabular-nums opacity-70">{entries.length}</span>
      </button>
      {projects.map((p) => (
        <button type="button" class={chip} data-project={p.name} aria-pressed="false">
          {p.name} <span class="tabular-nums opacity-70">{p.count}</span>
        </button>
      ))}
    </div>
  )}

  <div class="overflow-hidden rounded-lg border border-line bg-surface">
    <div class="hidden grid-cols-[8rem_5rem_8rem_1fr] gap-4 border-b border-line bg-bg px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-muted md:grid" aria-hidden="true">
      <span>Fecha</span><span>Versión</span><span>Proyecto</span><span>Cambios</span>
    </div>
    <ul class="divide-y divide-line">
      {entries.map((e) => (
        <li data-project={e.data.project ?? ""}>
          <a class="group grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 px-6 py-4 hover:bg-bg md:grid-cols-[8rem_5rem_8rem_1fr]" href={`/changelog/${e.slug}/`}>
            <time class="font-mono text-xs text-muted md:pt-0.5" datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time>
            <span class="font-mono text-sm font-medium">{e.data.version}</span>
            <span class="col-span-2 text-sm text-muted md:col-span-1">
              {e.data.project ?? "—"}
              {e.data.platform && <span class="ml-1 rounded border border-line px-1.5 py-px font-mono text-xs md:ml-0 md:mt-1 md:block md:w-fit">{e.data.platform}</span>}
            </span>
            <span class="col-span-2 text-[0.9375rem] group-hover:underline group-hover:decoration-brand group-hover:underline-offset-4 md:col-span-1">
              {releaseTitle(e)}
            </span>
          </a>
        </li>
      ))}
      {entries.length === 0 && <li class="px-6 py-4 text-muted">Sin versiones publicadas aún.</li>}
    </ul>
  </div>
</SiteLayout>

<script>
  const group = document.querySelector<HTMLElement>("[data-changelog-filter]");
  if (group) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>("button[data-project]")];
    const rows = [...document.querySelectorAll<HTMLElement>("li[data-project]")];

    const apply = (project: string) => {
      if (!buttons.some((b) => b.dataset.project === project)) project = "";
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.project === project)));
      rows.forEach((r) => (r.hidden = project !== "" && r.dataset.project !== project));
      const url = new URL(location.href);
      project ? url.searchParams.set("proyecto", project) : url.searchParams.delete("proyecto");
      history.replaceState(null, "", url);
    };

    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.project ?? "")));
    apply(new URLSearchParams(location.search).get("proyecto") ?? "");
  }
</script>
