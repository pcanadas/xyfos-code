---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import { getCollection } from "astro:content";
import { sortChangelog, releaseTitle, formatDate, isoDate } from "../../lib/content";

const entries = sortChangelog(await getCollection("changelog"));
---
<SiteLayout title="Changelog · Xyfos Code" description="Nuevas versiones y cambios de todos los proyectos de Xyfos Code.">
  <PageHeader
    eyebrow="Desarrollo en abierto"
    title="Changelog"
    intro="Nuevas versiones, correcciones y mejoras de todos los proyectos, en orden cronológico."
  >
    <a class="font-mono text-xs uppercase tracking-[0.14em] text-muted hover:text-ink" href="/changelog/rss.xml">Suscribirse por RSS</a>
  </PageHeader>

  <div class="overflow-hidden rounded-lg border border-line bg-surface">
    <div class="hidden grid-cols-[8rem_5rem_8rem_1fr] gap-4 border-b border-line bg-bg px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-muted md:grid" aria-hidden="true">
      <span>Fecha</span><span>Versión</span><span>Proyecto</span><span>Cambios</span>
    </div>
    <ul class="divide-y divide-line">
      {entries.map((e) => (
        <li>
          <a class="group grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 px-6 py-4 hover:bg-bg md:grid-cols-[8rem_5rem_8rem_1fr]" href={`/changelog/${e.slug}/`}>
            <time class="font-mono text-xs text-muted md:pt-0.5" datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time>
            <span class="font-mono text-sm font-medium">{e.data.version}</span>
            <span class="col-span-2 text-sm text-muted md:col-span-1">{e.data.project ?? "—"}</span>
            <span class="col-span-2 text-[0.9375rem] group-hover:underline group-hover:decoration-brand group-hover:underline-offset-4 md:col-span-1">
              {releaseTitle(e)}
            </span>
          </a>
        </li>
      ))}
      {entries.length === 0 && <li class="px-6 py-4 text-muted">Sin versiones publicadas aún.</li>}
    </ul>
  </div>
</SiteLayout>
