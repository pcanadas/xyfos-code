---
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../config/site";

const focus = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2";
---
<SiteLayout title="Página no encontrada · Xyfos Code" description="Esta página no existe o se ha movido.">
  <div class="py-10">
    <p class="text-sm font-semibold uppercase tracking-wider text-brand-text">Error 404</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">Esta página no existe</h1>
    <p class="mt-3 text-lg text-slate-700">
      Puede que se haya movido o que el enlace tenga un error.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a class={`rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800 ${focus}`} href="/">
        Ir al inicio
      </a>
      <a class={`rounded-md border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-50 ${focus}`} href="/projects">
        Ver proyectos
      </a>
    </div>

    <div class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-5 text-sm text-slate-700">
      <p>
        Si has llegado aquí desde un enlace de la propia web,
        <a class={`rounded-sm font-medium text-slate-900 underline decoration-brand-500/60 underline-offset-4 ${focus}`} href={`mailto:${site.email}?subject=${encodeURIComponent("Enlace roto en xyfos.com")}`}>avísame</a>
        y lo arreglo.
      </p>
    </div>
  </div>
</SiteLayout>
