---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Button from "../components/ui/Button.astro";
import { site } from "../config/site";
---
<SiteLayout title="Página no encontrada · Xyfos Code" description="Esta página no existe o se ha movido.">
  <div class="py-6 md:py-12">
    <PageHeader eyebrow="Error 404" title="Esta página no existe" intro="Puede que se haya movido o que el enlace tenga un error.">
      <div class="flex flex-wrap gap-3">
        <Button href="/">Ir al inicio</Button>
        <Button href="/projects" variant="secondary">Ver proyectos</Button>
      </div>
    </PageHeader>

    <p class="max-w-prose text-muted">
      Si has llegado aquí desde un enlace de la propia web,
      <a class="font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text" href={`mailto:${site.email}?subject=${encodeURIComponent("Enlace roto en xyfos.com")}`}>avísame</a>
      y lo arreglo.
    </p>
  </div>
</SiteLayout>
