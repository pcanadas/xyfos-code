---
import type { CollectionEntry } from "astro:content";
import { statusColors, statusLabels, formatDate } from "../../lib/content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Latest release per edition (see latestReleasesByProject). */
  releases?: CollectionEntry<"changelog">[];
}

const { project } = Astro.props;
const { title, description, status, problem, platform, stack, cover, coverAlt, editions } = project.data;
const availability = new Map(editions.map((ed) => [ed.name, ed.availability]));
// Same order as the editions in the project file
const editionIndex = (r: CollectionEntry<"changelog">) => editions.findIndex((ed) => ed.name === r.data.platform);
const releases = [...(Astro.props.releases ?? [])].sort((a, b) => editionIndex(a) - editionIndex(b));
---
<a
  href={`/projects/${project.slug}/`}
  class="group flex flex-col overflow-hidden rounded-lg border border-line bg-surface transition-colors duration-150 hover:border-ink/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
>
  <div class="aspect-[16/9] overflow-hidden border-b border-line bg-surface-warm p-4 sm:p-5">
    {cover ? (
      <img
        src={cover}
        alt={coverAlt ?? ""}
        width="1293"
        height="727"
        class="h-full w-full rounded border border-line object-cover object-top"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center rounded border border-dashed border-line-strong bg-surface" aria-hidden="true">
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-muted">Capturas próximamente</span>
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 class="text-xl font-semibold decoration-brand underline-offset-4 group-hover:underline">
          {title}
        </h3>
        {platform && <p class="mt-1 font-mono text-xs uppercase tracking-[0.1em] text-muted">{platform}</p>}
      </div>
      <span class={`shrink-0 rounded px-2 py-0.5 text-xs font-medium ring-1 ring-inset ${statusColors[status]}`}>
        {statusLabels[status]}
      </span>
    </div>

    <div class="flex-1 pb-6">
      <dl class="mt-5 space-y-4 text-[0.9375rem] leading-relaxed">
        {problem && (
          <div>
            <dt class="text-sm font-semibold">El problema</dt>
            <dd class="mt-1 text-muted">{problem}</dd>
          </div>
        )}
        <div>
          <dt class="text-sm font-semibold">La solución</dt>
          <dd class="mt-1 text-muted">{description}</dd>
        </div>
      </dl>

      {stack.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tecnologías">
          {stack.map((tech) => (
            <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">{tech}</li>
          ))}
        </ul>
      )}
    </div>

    <div class="flex items-end justify-between gap-3 border-t border-line pt-4 text-sm">
      {releases.length === 0 ? (
        <span class="text-muted">En desarrollo</span>
      ) : releases.length === 1 && !releases[0].data.platform ? (
        <span class="text-muted">
          Última versión <span class="font-mono font-medium text-ink">{releases[0].data.version}</span> · <span class="whitespace-nowrap">{formatDate(releases[0].data.date)}</span>
        </span>
      ) : (
        <ul class="space-y-1 text-muted" aria-label="Última versión de cada plataforma">
          {releases.map((r) => (
            <li>
              <span class="font-medium text-ink">{r.data.platform}</span>
              <span class="font-mono font-medium text-ink">{r.data.version}</span>
              {availability.get(r.data.platform ?? "") && <> · <span class="whitespace-nowrap">{availability.get(r.data.platform ?? "")}</span></>}
            </li>
          ))}
        </ul>
      )}
      <span class="shrink-0 whitespace-nowrap font-medium text-ink">Ver proyecto <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">→</span></span>
    </div>
  </div>
</a>
