---
/**
 * Page section with optional eyebrow + title header.
 *  - default: transparent over the page bg
 *  - warm:    #FFEEDD block, only for human sections (About, Process)
 *  - dark:    ink band (contact)
 * Full-bleed backgrounds; content stays inside .container-site.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  /** Section number shown before the eyebrow as "§01" (home "spec sheet" layout). */
  number?: number;
  title?: string;
  intro?: string;
  tone?: "default" | "warm" | "dark";
  class?: string;
}

const { id, eyebrow, number, title, intro, tone = "default", class: className = "" } = Astro.props;
const sectionNumber = number ? `§${String(number).padStart(2, "0")}` : undefined;
const headingId = id ? `${id}-title` : undefined;

const tones = {
  default: "",
  warm: "bg-surface-warm",
  dark: "bg-ink text-white",
};
const hasActions = Astro.slots.has("actions");
---
<section
  id={id}
  aria-labelledby={title ? headingId : undefined}
  class={`scroll-mt-6 py-section-sm md:py-section ${tones[tone]} ${className}`}
>
  <div class="container-site">
    {(title || eyebrow) && (
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          {eyebrow && (
            <p class={tone === "dark" ? "eyebrow text-brand" : "eyebrow"}>
              {sectionNumber && <span class={tone === "dark" ? "text-white/70" : "text-muted"}>{sectionNumber} · </span>}
              {eyebrow}
            </p>
          )}
          {title && (
            <h2 id={headingId} class={`mt-3 text-3xl font-semibold sm:text-4xl ${tone === "dark" ? "text-white" : ""}`}>
              {title}
            </h2>
          )}
          {intro && <p class={`mt-4 text-body ${tone === "dark" ? "text-white/75" : "text-muted"}`}>{intro}</p>}
        </div>
        {hasActions && <div class="shrink-0"><slot name="actions" /></div>}
      </div>
    )}
    <slot />
  </div>
</section>
