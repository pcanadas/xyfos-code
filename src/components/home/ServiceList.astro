---
/** Services as spec-sheet rows (not an icon-card grid); stacks on mobile. */
import type { Service } from "../../data/services";

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---
<ul class="border-t border-ink">
  {services.map((s, i) => (
    <li class="grid gap-x-8 gap-y-3 border-b border-line py-6 lg:grid-cols-[3rem_minmax(0,1.1fr)_minmax(0,1.6fr)_minmax(0,1fr)] lg:items-baseline lg:py-7">
      <span class="hidden font-mono text-xs text-muted tabular-nums lg:block" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
      <h3 class="flex items-center gap-3 text-lg font-semibold">
        <svg class="shrink-0 self-center text-ink" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
        <span><span class="mr-2 font-mono text-xs font-normal text-muted lg:hidden" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>{s.title}</span>
      </h3>
      <p class="text-[0.9375rem] leading-relaxed text-muted">{s.text}</p>
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 lg:flex-col lg:items-start">
        <p class="font-mono text-xs text-muted">
          <span class="sr-only">Tecnologías: </span>{s.tech.join(" · ")}
        </p>
        {s.example && (
          <a class="text-sm font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text" href={s.example.href}>
            {s.example.label} →
          </a>
        )}
      </div>
    </li>
  ))}
</ul>
