---
/** Featured case: screenshots + problem / solution + facts (from the changelog, or given for client work). */
import type { CollectionEntry } from "astro:content";
import HeroShowcase from "./HeroShowcase.astro";
import { sortChangelog, formatDate, isoDate } from "../../lib/content";

type Shot = { src: string; alt: string; width: number; height: number };
type Fact = { label: string; value: string; note: string };

interface Props {
  project: CollectionEntry<"projects">;
  releases: CollectionEntry<"changelog">[];
  desktop: Shot;
  phone: Shot;
  /** Second shot as a document page instead of a phone screen (see HeroShowcase). */
  secondary?: "phone" | "document";
  /** Third fact next to platforms and versions: a verifiable property of this product. */
  highlight: Fact;
  /** Replaces the platforms and versions facts (client work has no public changelog). */
  facts?: [Fact, Fact];
  /** Screenshots on the right on large screens, to alternate consecutive cases. */
  reverse?: boolean;
  class?: string;
}

const { project, releases, desktop, phone, secondary, highlight, facts, reverse = false, class: className = "" } = Astro.props;
const { title, problem, description, editions, stack, kind } = project.data;
const own = sortChangelog(releases.filter((r) => r.data.project === title));
const first = own.at(-1);
const platforms = editions.length ? editions.map((ed) => ed.platform === "Google Play" ? "Android" : ed.platform) : [project.data.platform];
const shownFacts: Fact[] = [
  ...(facts ?? [
    { label: "Plataformas", value: String(platforms.length), note: platforms.join(" · ") },
    { label: "Versiones", value: String(own.length), note: "" },
  ]),
  highlight,
];
---
<article class={`grid gap-10 rounded-lg border border-line bg-surface p-5 sm:p-8 lg:grid-cols-12 lg:gap-12 lg:p-10 ${className}`} aria-labelledby={`caso-${project.slug}`}>
  <div class={`rounded-md bg-surface-warm p-4 sm:p-6 lg:col-span-7 lg:self-start ${reverse ? "lg:order-last" : ""}`}>
    <HeroShowcase desktop={desktop} phone={phone} secondary={secondary} />
  </div>

  <div class="flex flex-col lg:col-span-5">
    <p class="eyebrow">Caso destacado · {kind === "client" ? "Proyecto para cliente" : "Producto propio"}</p>
    <h3 id={`caso-${project.slug}`} class="mt-3 text-3xl font-semibold">{title}</h3>

    <dl class="mt-6 space-y-5 text-[0.9375rem] leading-relaxed">
      {problem && (
        <div>
          <dt class="text-sm font-semibold">El problema</dt>
          <dd class="mt-1 text-muted">{problem}</dd>
        </div>
      )}
      <div>
        <dt class="text-sm font-semibold">La solución</dt>
        <dd class="mt-1 text-muted">{description} {stack.length > 0 && <>Construida con {stack.join(", ")}.</>}</dd>
      </div>
    </dl>

    <dl class="mt-8 grid grid-cols-3 border-y border-line">
      {shownFacts.map((f, i) => (
        <div class={i === 0 ? "py-4 pr-3" : i === 1 ? "border-l border-line px-3 py-4" : "border-l border-line py-4 pl-3"}>
          <dt class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-muted">{f.label}</dt>
          <dd class="mt-1 font-display text-2xl font-semibold tabular-nums">{f.value}</dd>
          <dd class="text-xs text-muted">
            {!facts && i === 1
              ? (first ? <>desde <time class="whitespace-nowrap" datetime={isoDate(first.data.date)}>{formatDate(first.data.date)}</time></> : "publicadas")
              : f.note}
          </dd>
        </div>
      ))}
    </dl>

    <a class="mt-8 inline-flex text-sm font-medium text-ink underline decoration-brand underline-offset-4 hover:text-brand-text" href={`/projects/${project.slug}/`}>
      Ver el caso completo →
    </a>
  </div>
</article>
