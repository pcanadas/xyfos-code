---
/** Process steps: vertical rail on mobile, horizontal line on desktop. Sits on the warm block. */
interface Step {
  title: string;
  text: string;
  /** What the client gets out of this step. */
  deliverable: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---
<ol class="ml-[1.125rem] grid lg:ml-0 lg:grid-cols-4 lg:gap-8">
  {steps.map((step, i) => (
    <li class="relative border-l border-ink/25 pb-10 pl-8 last:pb-0 lg:border-l-0 lg:border-t lg:pb-0 lg:pl-0 lg:pt-10">
      <span
        class="absolute -left-[1.125rem] top-0 inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink/25 bg-surface-warm font-mono text-xs font-medium text-ink lg:-top-[1.125rem] lg:left-0"
        aria-hidden="true"
      >
        {String(i + 1).padStart(2, "0")}
      </span>
      <h3 class="pt-1.5 text-lg font-semibold lg:pt-0">{step.title}</h3>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{step.text}</p>
      <p class="mt-4 rounded-md border border-line bg-surface px-4 py-3 text-sm">
        <span class="block font-mono text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-brand-text">Recibes</span>
        <span class="mt-1 block text-ink">{step.deliverable}</span>
      </p>
    </li>
  ))}
</ol>
