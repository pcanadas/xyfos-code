---
import { nav, site } from "../../config/site";

const link = "rounded-sm text-slate-600 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2";
---
<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto grid max-w-5xl gap-8 px-4 py-12 text-sm sm:grid-cols-2 md:grid-cols-3">
    <div>
      <img src="/brand/logo-lockup.svg" alt="Xyfos Code" width="221" height="28" class="h-7 w-auto" loading="lazy" />
      <p class="mt-4 max-w-xs text-slate-600">
        Diseño y desarrollo de software a medida: apps de escritorio, SaaS, automatizaciones y datos.
      </p>
    </div>

    <nav aria-label="Sitio">
      <h2 class="font-semibold text-slate-900">Sitio</h2>
      <ul class="mt-3 space-y-2">
        {nav.map((item) => (
          <li><a class={link} href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="font-semibold text-slate-900">Contacto</h2>
      <ul class="mt-3 space-y-2">
        <li><a class={link} href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class={link} href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
        <li><a class={link} href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
        <li><a class={link} href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-slate-200">
    <p class="mx-auto max-w-5xl px-4 py-5 text-xs text-slate-600">
      © {new Date().getFullYear()} {site.author} · {site.name}
    </p>
  </div>
</footer>
